{
    "name": "bannerstop/keycloak",
    "description": "Framework-agnostic Keycloak / OpenID Connect client: login with PKCE, logout, token verification against JWKS, role mapping and the admin user directory",
    "type": "library",
    "keywords": ["keycloak", "openid-connect", "oidc", "oauth2", "sso", "jwt", "pkce"],
    "license": "MIT",
    "authors": [
        {
            "name": "bannerstop GmbH",
            "homepage": "https://www.bannerstop.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-json": "*",
        "ext-openssl": "*",
        "psr/clock": "^1.0",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^2.0",
        "psr/simple-cache": "^2.0 || ^3.0"
    },
    "require-dev": {
        "nyholm/psr7": "^1.8.2",
        "phpunit/phpunit": "^12.0"
    },
    "suggest": {
        "ext-sodium": "To verify EdDSA (Ed25519) signed tokens",
        "guzzlehttp/guzzle": "A PSR-18 HTTP client (^7.0)",
        "php-http/guzzle6-adapter": "PSR-18 adapter for projects that are stuck on Guzzle 6",
        "symfony/http-client": "A PSR-18 HTTP client (Psr18Client)",
        "bannerstop/keycloak-bundle": "Symfony integration",
        "bannerstop/keycloak-laravel": "Laravel integration"
    },
    "autoload": {
        "psr-4": {
            "Bannerstop\\Keycloak\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Bannerstop\\Keycloak\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
